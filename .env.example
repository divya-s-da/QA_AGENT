# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real credentials.

# LLM backend. config.py reads AIROUTER_API_KEY first (aiRouter.ch,
# OpenAI-compatible). If it is empty, it falls back to OPENCODE_GO_API_KEY.
AIROUTER_API_KEY=your-airouter-key-here

# Fallback backend (opencode.ai/zen/go) — only used when AIROUTER_API_KEY is unset
OPENCODE_GO_API_KEY=

# Target site login credentials. Only tools/site_login.py reads them; they
# are never put into a prompt, so the LLM provider never sees them.
SITE_EMAIL=user@example.com
SITE_PASSWORD=your-password
SITE_PASSWORD_FALLBACK=

# Write guard (ADK web / qa_ui path). The CLI pipeline takes the mode from the
# charter instead. read-only blocks every POST/PUT/PATCH/DELETE in the browser.
QA_WRITE_MODE=read-only
# Comma-separated URL patterns that may write even in read-only mode, e.g. an
# app that reads data through POST: */api/search,*/api/auth/refresh
QA_WRITE_ALLOWLIST=

# Domain for the throwaway signup-test account (allow-writes runs only).
QA_SIGNUP_EMAIL_DOMAIN=example.com

# Optional: file used for upload-testing checks. Leave empty to skip uploads.
TEST_FILE_PATH=
